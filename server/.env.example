# Configuración del Backend

# OpenAI API Key (OBLIGATORIO)
# Consigue tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-tu-api-key-aqui

# Puerto del servidor (default: 8080)
PORT=8080

# Entorno de ejecución (development | production)
NODE_ENV=production

# Modelo Realtime de OpenAI (opcional, default: gpt-realtime)
# Alternativas: gpt-realtime-mini (más económico), gpt-realtime-2 (razonamiento)
REALTIME_MODEL=gpt-realtime

# Voz del asistente (opcional, default: coral)
# Opciones: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
# OpenAI recomienda marin o cedar para mejor calidad de audio
REALTIME_VOICE=coral

# ==================================
# Keepalive de Supabase (opcional)
# ==================================
# Evita que el plan Free pause el proyecto por inactividad (~7 días) haciendo
# un GET periódico a la API REST. Si no defines URL y KEY el servidor arranca
# igual, solo que sin keepalive.

# URL del proyecto (Supabase > Settings > API > Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anon (Supabase > Settings > API > anon public)
SUPABASE_ANON_KEY=tu-anon-key-aqui

# Tabla contra la que se hace el ping (opcional, default: keepalive)
# Necesita una policy de RLS que permita SELECT al rol anon.
SUPABASE_KEEPALIVE_TABLE=keepalive

# Frecuencia del ping en horas (opcional, default: 24)
SUPABASE_KEEPALIVE_INTERVAL_HOURS=24
